                  "// This script can be used to simulate high load testing",
                  "// Uncomment and modify for actual load testing",
                  "/*",
                  "for (let i = 0; i < 10; i++) {",
                  "    setTimeout(() => {",
                  "        pm.sendRequest({",
                  "            url: pm.request.url.toString(),",
                  "            method: 'GET',",
                  "            header: {",
                  "                'Authorization': 'Bearer ' + pm.environment.get('valid_token')",
                  "            }",
                  "        }, function (err, res) {",
                  "            console.log(res.status);",
                  "        });",
                  "    }, i * 100);",
                  "}",
                  "*/"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{valid_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "Test the plugin under high load to ensure it continues to function correctly."
          },
          "response": []
        },
        {
          "name": "Different HTTP Methods",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Plugin should handle POST requests\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.response.to.have.header(\"X-User-Id\");",
                  "    pm.response.to.have.header(\"X-Request-Id\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{valid_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"example request data\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "Test the plugin with different HTTP methods to ensure it works with all types of requests."
          },
          "response": []
        }
      ],
      "description": "More advanced testing scenarios"
    }
  ],
