{
  "info": {
    "name": "Auth Token Exchange Plugin",
    "description": "Collection for testing the Auth Token Exchange Plugin middleware for Traefik",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345678"
  },
  "item": [
    {
      "name": "Valid Authentication Tests",
      "item": [
        {
          "name": "Request with Valid Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{valid_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "This request uses a valid token that should be successfully verified by the auth service."
          },
          "response": []
        },
        {
          "name": "Verify Headers Were Added",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test that the auth plugin added the expected headers",
                  "pm.test(\"X-User-Id header should be present\", function () {",
                  "    pm.response.to.have.header(\"X-User-Id\");",
                  "});",
                  "",
                  "pm.test(\"X-Request-Id header should be present\", function () {",
                  "    pm.response.to.have.header(\"X-Request-Id\");",
                  "});",
                  "",
                  "pm.test(\"X-User-Info header should be present\", function () {",
                  "    pm.response.to.have.header(\"X-User-Info\");",
                  "});",
                  "",
                  "// Test valid UUID v7 format for X-Request-Id",
                  "pm.test(\"X-Request-Id should be a valid UUID v7\", function () {",
                  "    const requestId = pm.response.headers.get(\"X-Request-Id\");",
                  "    const uuidV7Regex = /^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;",
                  "    pm.expect(requestId).to.match(uuidV7Regex);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{valid_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "Verifies that the plugin has correctly added X-User-Id, X-Request-Id, and X-User-Info headers."
          },
          "response": []
        }
      ],
      "description": "Tests for scenarios with valid authentication tokens"
    },
    {
      "name": "Test Token (Non-Production)",
      "item": [
        {
          "name": "Request with Test Token (Non-Production)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This script ensures we're testing in non-production mode",
                  "// The plugin should be configured with production: false"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK for test token\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer test-token",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "When in non-production mode, the plugin should accept 'test-token' without verifying with the auth service."
          },
          "response": []
        }
      ],
      "description": "Tests for the special test token handling in non-production mode"
    },
    {
      "name": "Error Handling Tests",
      "item": [
        {
          "name": "Missing Authorization Header",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized for missing header\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "Requests without an Authorization header should be rejected with 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "Invalid Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized for invalid token\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{invalid_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "Tokens that don't pass verification should be rejected with 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "Test Token in Production Mode",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This request assumes the plugin is configured with production: true"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test token should be rejected in production mode\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer test-token",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url_production}}/api/protected-resource",
              "host": [
                "{{base_url_production}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "In production mode, even the test-token should be verified with the auth service."
          },
          "response": []
        }
      ],
      "description": "Tests for error handling in different scenarios"
    },
    {
      "name": "Auth Service Tests",
      "item": [
        {
          "name": "Direct Auth Service Test",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{valid_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{auth_url}}",
              "host": [
                "{{auth_url}}"
              ]
            },
            "description": "Test the auth service directly to ensure it's working correctly."
          },
          "response": []
        },
        {
          "name": "Auth Service Down Simulation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This test should be run when the auth service is unavailable",
                  "// to test the retry mechanism and error handling of the plugin"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Plugin should handle auth service being down\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{valid_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/protected-resource",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "protected-resource"
              ]
            },
            "description": "This test simulates the auth service being down. The plugin should retry and eventually return a 500 error if it can't reach the auth service."
          },
          "response": []
        }
      ],
      "description": "Tests related to the authentication service"
    },
    {
