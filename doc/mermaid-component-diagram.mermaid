graph TD
    A[Client] -->|Request with Auth token| B[Traefik]
    
    subgraph Plugin Internals
        C[CustomAuth<br/>ServeHTTP]
        D[Check Auth header]
        E[Test token check<br/>for non-production]
        F[Generate UUID v7<br/>for X-Request-Id]
        G[Authentication<br/>with retry mechanism]
        H[Process user info]
        I[Set headers<br/>X-User-Id<br/>X-Request-Id]
        J[Remove Auth header]
    end
    
    B -->|Forward to plugin| C
    C --> D
    D --> E
    E -->|If production or<br/>not test-token| F
    F --> G
    G -->|Call auth service| K[External Auth Service]
    K -->|Return user data| H
    H --> I
    I --> J
    J -->|Modified request| L[Next handler]
    L -->|Response| A
    
    classDef plugin fill:#d9edf7,stroke:#333,stroke-width:1px;
    classDef external fill:#f5f5f5,stroke:#333,stroke-width:2px;
    
    class A,K external;
    class C,D,E,F,G,H,I,J plugin;
